# Dokploy injects these values from the Compose application's Environment tab.
# Keep this file as a reference only; do not commit a production .env file.

POSTGRES_USER=superadmin
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=superadmin

# The migrate service uses the database owner connection.
DATABASE_URL=postgresql://superadmin:replace-with-a-long-random-password@postgres:5432/superadmin
# The API should use the restricted runtime role created by Prisma migrations.
APP_DATABASE_URL=postgresql://app_runtime:replace-with-the-runtime-password@postgres:5432/superadmin

JWT_ACCESS_SECRET=replace-with-openssl-rand-hex-48
MFA_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32
PLATFORM_OWNER_EMAIL=owner@example.com
PLATFORM_OWNER_NAME=Platform Owner
LOG_LEVEL=info

# Public URLs, not Docker service names.
CORS_ORIGIN=https://admin.example.com
VITE_API_BASE_URL=https://api.example.com/api/v1
