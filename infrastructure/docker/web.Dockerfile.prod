# Imagen de PRODUCCION para apps/web-superadmin. Compila la SPA a archivos
# estaticos y los sirve con nginx -- no hay Node corriendo en runtime.
#
# VITE_API_BASE_URL queda "horneado" dentro del bundle JS en tiempo de build
# (asi es como funcionan las env vars de Vite: no se pueden cambiar en
# runtime sin reconstruir). Si necesitas apuntar a otra API, reconstruye la
# imagen con --build-arg VITE_API_BASE_URL=https://api.tudominio.com/api/v1
#
# Alternativa mas barata que ECS para esta imagen en particular: subir
# dist/ directo a un bucket S3 + CloudFront (sin contenedor corriendo 24/7).
# Se documenta como opcion en AWS_DEPLOYMENT_GUIDE.md; esta imagen queda
# disponible si prefieres mantener todo en ECS por simplicidad operativa.
#
# Build (desde la raiz del monorepo):
#   docker build -f infrastructure/docker/web.Dockerfile.prod \
#     --build-arg VITE_API_BASE_URL=https://api.tudominio.com/api/v1 \
#     -t superadmin-web:latest .

FROM node:20-alpine AS deps
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* ./
COPY apps/web-superadmin/package.json ./apps/web-superadmin/package.json
COPY packages ./packages

RUN pnpm install --filter @superadmin/web-superadmin... --frozen-lockfile

# ---------------------------------------------------------------------------
FROM deps AS build
COPY apps/web-superadmin ./apps/web-superadmin

ARG VITE_API_BASE_URL=http://localhost:3001/api/v1
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

RUN pnpm --filter @superadmin/web-superadmin build

# ---------------------------------------------------------------------------
FROM nginx:1.27-alpine AS runner
COPY infrastructure/docker/nginx.spa.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web-superadmin/dist /usr/share/nginx/html

EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://localhost/health || exit 1
