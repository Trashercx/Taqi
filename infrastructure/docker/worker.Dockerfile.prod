# Imagen de PRODUCCION para apps/worker. Ver api.Dockerfile.prod para las
# razones de cada etapa (build separado, prod-deps, usuario sin privilegios).
#
# Build (desde la raiz del monorepo):
#   docker build -f infrastructure/docker/worker.Dockerfile.prod -t superadmin-worker:latest .

FROM node:20-alpine AS deps
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* ./
COPY apps/worker/package.json ./apps/worker/package.json
COPY packages ./packages

RUN pnpm install --filter @superadmin/worker... --frozen-lockfile

# ---------------------------------------------------------------------------
FROM deps AS build
COPY apps/worker ./apps/worker
RUN pnpm --filter @superadmin/worker build

# ---------------------------------------------------------------------------
# Reinstalacion limpia en vez de "pnpm prune --prod": ver la nota larga en
# api.Dockerfile.prod sobre por que prune dejaba symlinks huerfanos aqui.
FROM node:20-alpine AS prod-deps
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* ./
COPY apps/worker/package.json ./apps/worker/package.json
COPY packages ./packages

RUN pnpm install --filter @superadmin/worker... --prod --frozen-lockfile

# ---------------------------------------------------------------------------
FROM node:20-alpine AS runner
RUN apk add --no-cache dumb-init
RUN addgroup -g 1001 -S nodejs && adduser -S worker -u 1001

WORKDIR /app
COPY --from=prod-deps --chown=worker:nodejs /app/node_modules ./node_modules
COPY --from=prod-deps --chown=worker:nodejs /app/packages ./packages
# Ver la nota en api.Dockerfile.prod: los symlinks de las dependencias
# DIRECTAS de apps/worker viven en apps/worker/node_modules, no en la raiz.
COPY --from=prod-deps --chown=worker:nodejs /app/apps/worker/node_modules ./apps/worker/node_modules
COPY --from=build --chown=worker:nodejs /app/apps/worker/dist ./apps/worker/dist
COPY --from=build --chown=worker:nodejs /app/apps/worker/package.json ./apps/worker/package.json

WORKDIR /app/apps/worker
USER worker

ENV NODE_ENV=production

CMD ["dumb-init", "node", "dist/main.js"]
