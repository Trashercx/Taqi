NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# Usado por `prisma migrate` (dueño de las tablas).
DATABASE_URL=postgresql://superadmin:superadmin@localhost:5432/superadmin
# Usado por el proceso de la API en tiempo de ejecucion (rol de menor
# privilegio, sin UPDATE/DELETE sobre audit_logs -- ver migracion
# 0002_app_runtime_role y docs/adr).
APP_DATABASE_URL=postgresql://app_runtime:CHANGE_ME@localhost:5432/superadmin

REDIS_URL=redis://localhost:6379

# openssl rand -hex 48
JWT_ACCESS_SECRET=CHANGE_ME
# openssl rand -hex 32
MFA_ENCRYPTION_KEY=CHANGE_ME

PLATFORM_OWNER_EMAIL=owner@example.com
PLATFORM_OWNER_NAME="Platform Owner"
